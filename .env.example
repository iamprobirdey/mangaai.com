# --- Supabase (Project settings → API keys) ---
NEXT_PUBLIC_SUPABASE_URL=https://guvmmahhqajqznbflufw.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_LXB42IGoZ2-QCVUV9sSq0g_IcAy7txY
# Paste the "vercel_production" secret key (Supabase → Project settings → API keys). Server only.
SUPABASE_SECRET_KEY=

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Long random string used to sign the child-profile and parent-PIN cookies: `openssl rand -base64 48`
APP_SECRET=change-me
# Timezone used for "today" in streaks, daily time limits and the weekly email
APP_TIMEZONE=Asia/Kolkata

# --- Razorpay (Dashboard → Account & Settings → API keys; Subscriptions → Plans) ---
RAZORPAY_KEY_ID=rzp_test_TvjOKFO8amf6XD
RAZORPAY_KEY_SECRET=xxx
RAZORPAY_WEBHOOK_SECRET=xxx
# Country-based pricing. India sees INR; other countries see USD if the USD plans are set
# (needs international payments enabled on Razorpay), otherwise everyone gets INR.
# Amounts are in the smallest unit (paise / cents) and must match the Razorpay plans.
RAZORPAY_PLAN_MONTHLY_INR=plan_TvyYMAHfvVDIma
RAZORPAY_PLAN_ANNUAL_INR=plan_TvyZKEnPjczZI7
PLAN_MONTHLY_AMOUNT_INR=74900
PLAN_ANNUAL_AMOUNT_INR=574900
RAZORPAY_PLAN_MONTHLY_USD=
RAZORPAY_PLAN_ANNUAL_USD=
PLAN_MONTHLY_AMOUNT_USD=900
PLAN_ANNUAL_AMOUNT_USD=6900
# Force a pricing region while testing locally: IN or INTL (leave empty in production)
PRICING_REGION=
TRIAL_DAYS=7
GRACE_DAYS=3

# --- Email (Resend) ---
RESEND_API_KEY=re_xxx
EMAIL_FROM="MangaAI <hello@mangaai.com>"

# --- Cron (Vercel sends this as a Bearer token automatically) ---
CRON_SECRET=change-me

# Resend webhook signing secret (Resend → Webhooks), for email open tracking
RESEND_WEBHOOK_SECRET=whsec_xxx
